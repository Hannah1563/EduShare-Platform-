# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is git-ignored: it holds your IPs, so never commit it.

resource_group_name = "edushare-summative-rg"
location            = "southafricanorth"
environment         = "prod"

# Public IP + /32 of each teammate who needs SSH to the bastion.
# Find yours with: curl -4 -s ifconfig.me
allowed_ssh_cidrs = [
  "YOUR_PUBLIC_IP/32",
]

# One PUBLIC key per teammate, plus the CD pipeline's deploy key (.pub files only).
ssh_public_key_paths = [
  "~/.ssh/alu-devops.pub",
  # "keys/hannah.pub",
  # "keys/cd-deploy.pub",
]

# Optional overrides
# app_vm_size        = "Standard_B2als_v2"
# bastion_vm_size    = "Standard_B2ats_v2"
# enable_nat_gateway = true
# cosmos_free_tier   = true
