# {{ ansible_managed }}
# The image is pulled from the private registry (ACR), never built on the server.
# The database is Azure Cosmos DB (managed), reached through MONGODB_URI.
name: edushare

services:
  app:
    image: "{{ app_image }}:{{ app_image_tag }}"
    restart: unless-stopped
    env_file: .env
    # Published on the VM's private IP only. The Azure NSG and UFW allow this
    # port from the bastion's subnet only, where Nginx forwards website traffic.
    ports:
      - "{{ app_container_port }}:{{ app_container_port }}"
    # The image already runs as the unprivileged "node" user; also drop all
    # Linux capabilities and block privilege escalation.
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:{{ app_container_port }}{{ app_health_path }} || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
